{
  "name": "ai-app-builder-saas",
  "private": true,
  "version": "1.2.0",
  "description": "AI App Builder SaaS — generate, preview, edit, and export web apps from natural language. Locally-runnable MVP of the PRD architecture (Hono API + Next.js client).",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @aiab/api dev\" \"pnpm --filter @aiab/web dev\"",
    "build": "pnpm --filter @aiab/api build && pnpm --filter @aiab/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @aiab/api seed",
    "start": "concurrently -n api,web -c blue,magenta \"pnpm --filter @aiab/api start\" \"pnpm --filter @aiab/web start\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
