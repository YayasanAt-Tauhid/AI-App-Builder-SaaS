{
  "name": "@aiab/api",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Edge-portable Hono API for AI App Builder. Runs locally on Node with adapters that stand in for Cloudflare D1 (sharded SQLite), R2 (filesystem), KV (in-memory), and the CreditMeter Durable Object (in-process serialized counter).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker-lite.json",
    "typecheck:cf": "tsc --noEmit -p tsconfig.worker.json",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:migrate": "for i in 0 1 2 3; do wrangler d1 migrations apply aiab-shard-$i --remote; done"
  },
  "dependencies": {
    "@aiab/shared": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260529.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.95.0"
  }
}
