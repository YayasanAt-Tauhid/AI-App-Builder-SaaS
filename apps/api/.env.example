# ──────────────────────────────────────────────────────────────────────────
# API environment (apps/api). Copy to .env and fill in what you need.
# EVERYTHING IS OPTIONAL: with no values set, the API runs in "mock" mode —
# dev auth, a deterministic offline code generator, and a simulated upgrade —
# so the whole product works with zero credentials. Add keys to go live.
# ──────────────────────────────────────────────────────────────────────────

# Server
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
D1_SHARD_COUNT=4
# DATA_DIR=./.data            # where local D1 shards + R2 blobs are stored

# AI providers — set any subset. A model uses its real provider when that
# provider's key is present; otherwise it falls back to the mock generator.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=...
# FORCE_MOCK=1                # force the mock generator even if keys exist

# Clerk auth — set issuer (or JWKS) to require real Clerk JWTs. Without these
# the API runs in dev-auth mode (identifies users by the x-dev-user header).
# CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_WEBHOOK_SECRET=whsec_...

# Stripe billing — set the secret key to create real Checkout/Portal sessions.
# Without it, billing runs in mock mode (the /billing/mock-checkout flow).
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
